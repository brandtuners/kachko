# Local development only. Docker Compose reads the root .env.
# Copy this file to .env; keep real credentials out of Git.
POSTGRES_USER=kachko
POSTGRES_PASSWORD=kachko
POSTGRES_DB=kachko
POSTGRES_PORT=5432
REDIS_PORT=6379

# Host-side connection examples, used by root Prisma migration commands.
# Keep these and apps/api/.env in sync if credentials, database, or ports change.
# Percent-encode special characters in credentials when constructing a URL.
DATABASE_URL=postgresql://kachko:kachko@127.0.0.1:5432/kachko
REDIS_URL=redis://127.0.0.1:6379
