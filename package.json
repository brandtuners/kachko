  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:smoke": "robot --outputdir apps/api/test/robot/results apps/api/test/robot/v1_smoke.robot",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:analytics:prune": "prisma db execute --file prisma/analytics-retention.sql",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:studio": "prisma studio",
    "db:test": "pnpm --filter api test:db"
  },
  "keywords": [],
