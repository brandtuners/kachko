  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.12",
    "prisma": "7.10.0",
    "dotenv": "^17.0.0"
  }
