NODE_ENV=development
PORT=4000
# FE and local Swagger UI origins; update the Swagger port if PORT changes.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Local services from the repository's docker-compose.yml.
# NestJS reads apps/api/.env when started with pnpm --filter api dev.
# Required by NestJS at runtime. Prisma migration commands separately use root .env.
DATABASE_URL=postgresql://kachko:kachko@127.0.0.1:5432/kachko
REDIS_URL=redis://127.0.0.1:6379

# Bounds readiness probes and PostgreSQL connection/query timeouts (100–10000 ms).
DEPENDENCY_TIMEOUT_MS=2000

# Identity: absolute session lifetime (60–2592000 seconds); default seven days.
SESSION_COOKIE_NAME=kachko_session
SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
PUBLIC_APP_URL=http://localhost:3000
# Clerk Backend API secret for verifying browser session tokens. Pull a local
# development value with `pnpm dlx clerk@latest env pull --file apps/api/.env`.
CLERK_SECRET_KEY=
# Signing secret for a Clerk webhook subscribed to subscription and
# subscriptionItem lifecycle events at /api/v1/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Social account connection (separate from Google sign-in). Configure all three
# OAuth fields for each enabled provider. Generate 32 random bytes in base64 for
# the token key; keep the same key across API replicas and deployments.
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_INSTAGRAM_REDIRECT_URI=
SOCIAL_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
SOCIAL_INSTAGRAM_API_VERSION=v25.0
SOCIAL_DM_MONTHLY_LIMIT=2500
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_YOUTUBE_REDIRECT_URI=
# Required in production. Development logs reset links to the API console.
RESEND_API_KEY=
EMAIL_FROM=KACHKO <no-reply@example.com>
ANALYTICS_HASH_SALT=replace-with-at-least-32-random-characters

# Optional Google sign-in; obtain a Web application OAuth client in Google Cloud.
# Keep both credentials empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Optional fixed FE callback; leave empty for local API-only testing.
GOOGLE_LOGIN_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Managed images. Local mode stores private upload bytes under tmp/media and
# serves completed assets through the API. Use r2 in deployed environments.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./tmp/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
