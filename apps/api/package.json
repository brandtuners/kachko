{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm contracts:build && pnpm db:generate && nest start --watch",
    "build": "pnpm contracts:build && pnpm db:generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "pnpm contracts:build && pnpm db:generate && tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.cjs",
    "db:generate": "pnpm -w db:generate",
    "test:db": "pnpm build && node --test test/database/*.test.cjs",
    "test:infra": "pnpm build && node --test test/infrastructure/*.test.cjs",
    "contracts:build": "pnpm --filter @kachko/types --filter @kachko/validation build",
    "test:auth": "pnpm build && node --test test/infrastructure/auth.test.cjs",
    "test:pages": "pnpm build && node --test test/infrastructure/pages.test.cjs"
  },
  "dependencies": {
    "@kachko/types": "workspace:*",
    "@kachko/validation": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "redis": "6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "11.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
