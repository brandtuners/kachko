generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  clerkUserId   String?   @unique
  email         String    @unique
  username      String    @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  avatarMediaId String?   @unique
  bio           String?
  role          UserRole  @default(USER)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  billingPlan     String    @default("free")
  billingFeatures String[]  @default([])
  billingUpdatedAt DateTime?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  googleAccount       GoogleAccount?
  pages               Page[]
  media               Media[]              @relation("OwnedMedia")
  avatarMedia         Media?               @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: Restrict)
  reports             Report[]             @relation("ReportReporter")
  handledReports      Report[]             @relation("ReportHandler")
  auditLogs           AuditLog[]           @relation("AuditActor")
  contacts            Contact[]            @relation("ContactOwner")
  contactNotes        ContactNote[]        @relation("ContactNoteAuthor")
  contactTags         Tag[]                @relation("TagOwner")
  shortLinks          ShortLink[]
  socialAccounts      SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique email/username constraints already create their lookup indexes.
  @@index([createdAt])
}

model ShortLink {
  id             String @id @default(uuid())
  userId         String
  code           String @unique
  title          String?
  destinationUrl String
  utm            Json @default("{}")
  channel        String?
  tags           String[] @default([])
  isActive       Boolean @default(true)
  clickCount     Int @default(0)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks         ShortLinkClick[]
  aliases        ShortLinkAlias[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([userId, createdAt])
}

model ShortLinkAlias {
  code        String @id
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  @@index([shortLinkId])
}

model ShortLinkClick {
  id          String @id @default(uuid())
  shortLinkId String
  device      String?
  referrer    String?
  country     String?
  createdAt   DateTime @default(now())
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  @@index([shortLinkId, createdAt])
}

model SocialAccount {
  id               String @id @default(uuid())
  userId           String
  platform         String
  externalId       String
  username         String
  avatarUrl        String?
  accessToken      String
  refreshToken     String?
  tokenExpiresAt   DateTime?
  scopes           String[] @default([])
  status           String @default("CONNECTED")
  lastSyncedAt     DateTime?
  lastSyncError    String?
  report           Json @default("{}")
  syncLeaseUntil   DateTime?
  nextSyncAt       DateTime @default(now())
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots        SocialSnapshot[]
  media            SocialMedia[]
  automations      DmAutomation[]
  deliveries       DmDelivery[]
  commentEvents    SocialCommentEvent[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([platform, externalId])
  @@index([userId, platform])
  @@index([status, nextSyncAt])
}

model SocialSnapshot {
  id         String @id @default(uuid())
  accountId  String
  date       DateTime @db.Date
  followers  Int?
  posts      Int?
  views      BigInt?
  reach      Int?
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, date])
}

model SocialMedia {
  id          String @id @default(uuid())
  accountId   String
  externalId  String
  caption     String?
  permalink   String?
  mediaType   String
  publishedAt DateTime
  likes       Int?
  comments    Int?
  views       BigInt?
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, externalId])
  @@index([accountId, publishedAt])
}

model DmAutomation {
  id             String @id @default(uuid())
  accountId      String
  name           String
  triggerType    String
  mediaId        String?
  matchType      String
  keywords       String[] @default([])
  message        String
  buttonLabel    String
  destinationUrl String
  publicReply    String?
  isActive       Boolean @default(true)
  deletedAt      DateTime?
  triggerStartedAt DateTime @default(now())
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deliveries     DmDelivery[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([accountId, isActive])
}

model DmDelivery {
  id               String @id @default(uuid())
  accountId        String
  automationId     String
  commentId        String
  mediaId          String
  commentCreatedAt DateTime
  status           String @default("PENDING")
  message          String
  buttonLabel      String
  destinationUrl   String
  publicReply      String?
  clickToken       String @unique
  clickCount       Int @default(0)
  providerMessageId String?
  errorCode        String?
  sentAt           DateTime?
  claimedAt        DateTime?
  nextAttemptAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  account          SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automation       DmAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  @@unique([accountId, commentId])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([accountId, createdAt])
}

model SocialCommentEvent {
  id          String @id @default(uuid())
  accountId   String
  commentId   String
  mediaId     String
  text        String
  occurredAt  DateTime
  status      String @default("PENDING")
  attempts    Int @default(0)
  claimedAt   DateTime?
  nextAttemptAt DateTime @default(now())
  errorCode   String?
  createdAt   DateTime @default(now())
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, commentId])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Google subject is stable; email alone must never link an existing account.
model GoogleAccount {
  subject   String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// V1 supports multiple pages per owner. One page is primary and resolves at
// /username; additional pages resolve at /username/page-slug.
model Page {
  id                  String           @id @default(uuid())
  userId              String
  slug                String
  isPrimary           Boolean          @default(false)
  title               String?
  description         String?
  isPublished         Boolean          @default(true)
  publishedAt         DateTime?         @default(now())
  themeKey            String           @default("default")
  theme               Theme            @relation(fields: [themeKey], references: [slug], onDelete: Restrict)
  appearanceOverrides Json             @default("{}")
  socials             SocialProfile[]
  revision            Int              @default(0)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks              PageBlock[]
  analytics           AnalyticsEvent[]
  reports             Report[]
  forms               Form[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([userId, slug])
  @@index([userId, createdAt])
  @@index([userId, isPrimary])
  @@index([isPublished])
}

model Report {
  id          String       @id @default(uuid())
  pageId      String
  reporterId  String?
  reason      ReportReason
  details     String?
  status      ReportStatus @default(OPEN)
  handledById String?
  handledAt   DateTime?
  page        Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reporter    User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy   User?        @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([pageId, createdAt])
  @@index([reporterId, createdAt])
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  ILLEGAL_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model PageBlock {
  id        String           @id @default(uuid())
  pageId    String
  type      BlockType
  position  Int
  isVisible Boolean          @default(true)
  content   Json
  mediaId   String?
  page      Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  analytics AnalyticsEvent[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([pageId, position])
  @@index([pageId, isVisible, position])
  @@index([mediaId])
}

model Media {
  id         String      @id @default(uuid())
  userId     String
  storageKey String      @unique
  url        String
  mimeType   String
  size       BigInt
  width      Int
  height     Int
  user       User        @relation("OwnedMedia", fields: [userId], references: [id], onDelete: Cascade)
  avatarFor  User[]      @relation("UserAvatar")
  blocks     PageBlock[]
  createdAt  DateTime    @default(now())

  @@index([userId, createdAt])
}

// Add additional block types only with their validated feature implementations.
enum BlockType {
  LINK
  TEXT
  IMAGE
  SOCIAL
  DIVIDER
  YOUTUBE
  SPOTIFY
  EMAIL
  PHONE
  LOCATION
  WHATSAPP
  FORM
  SUBSCRIBE
}

model Theme {
  id         String         @id @default(uuid())
  name       String
  slug       String         @unique
  isSystem   Boolean        @default(true)
  background Json
  typography Json
  buttons    Json
  cards      Json
  pages      Page[]
  templates  PageTemplate[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model PageTemplate {
  key         String @id
  name        String
  description String
  themeKey    String
  theme       Theme  @relation(fields: [themeKey], references: [slug], onDelete: Restrict)
  blocks      Json
}

model SocialProfile {
  id        String           @id @default(uuid())
  pageId    String
  platform  SocialPlatform
  username  String?
  url       String
  position  Int
  isVisible Boolean          @default(true)
  page      Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  analytics AnalyticsEvent[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([pageId, position])
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
  X
  LINKEDIN
  FACEBOOK
  TIKTOK
  GITHUB
  DISCORD
  TWITCH
  SPOTIFY
}

model AnalyticsEvent {
  id              String             @id @default(uuid())
  pageId          String
  blockId         String?
  socialProfileId String?
  eventType       AnalyticsEventType
  ipHash          String?
  country         String?
  city            String?
  device          String?
  browser         String?
  os              String?
  referrer        String?
  createdAt       DateTime           @default(now())
  page            Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  block           PageBlock?         @relation(fields: [blockId], references: [id], onDelete: SetNull)
  socialProfile   SocialProfile?     @relation(fields: [socialProfileId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@index([pageId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@index([socialProfileId])
}

enum AnalyticsEventType {
  PAGE_VIEW
  LINK_CLICK
  SOCIAL_CLICK
  FORM_VIEW
  FORM_SUBMIT
  LEAD_CREATED
  WHATSAPP_CLICK
  SUBSCRIBE
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum FormSuccessType {
  MESSAGE
  REDIRECT
}

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  CHECKBOX
}

model Contact {
  id             String           @id @default(uuid())
  ownerUserId    String
  name           String?
  email          String?
  phone          String?
  status         ContactStatus    @default(NEW)
  source         String?
  sourceDetails  Json?
  marketingOptIn Boolean          @default(false)
  lastActivityAt DateTime?
  owner          User             @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  submissions    FormSubmission[]
  notes          ContactNote[]
  tags           ContactTag[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, email])
  @@index([ownerUserId, phone])
  @@index([ownerUserId, status])
}

model Form {
  id            String           @id @default(uuid())
  pageId        String
  name          String
  title         String?
  description   String?
  submitLabel   String           @default("Submit")
  successType   FormSuccessType  @default(MESSAGE)
  successConfig Json?
  isActive      Boolean          @default(true)
  page          Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fields        FormField[]
  submissions   FormSubmission[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([pageId])
}

model FormField {
  id          String        @id @default(uuid())
  formId      String
  type        FormFieldType
  label       String
  name        String
  placeholder String?
  required    Boolean       @default(false)
  position    Int
  config      Json?
  form        Form          @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, name])
  @@index([formId, position])
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String
  contactId   String?
  payload     Json
  attribution Json?
  ipHash      String?
  createdAt   DateTime @default(now())
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@index([contactId, createdAt])
  @@index([ipHash, createdAt])
}

model ContactNote {
  id        String   @id @default(uuid())
  contactId String
  authorId  String
  note      String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author    User     @relation("ContactNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

model Tag {
  id          String       @id @default(uuid())
  ownerUserId String
  name        String
  owner       User         @relation("TagOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  contacts    ContactTag[]
  createdAt   DateTime     @default(now())

  @@unique([ownerUserId, name])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}
