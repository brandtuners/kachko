generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String?
  displayName  String?
  avatarUrl    String?
  avatarMediaId String? @unique
  bio          String?
  role         UserRole  @default(USER)
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  sessions Session[]
  googleAccount GoogleAccount?
  page Page?
  media Media[] @relation("OwnedMedia")
  avatarMedia Media? @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique email/username constraints already create their lookup indexes.
  @@index([createdAt])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Google subject is stable; email alone must never link an existing account.
model GoogleAccount {
  subject String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// V1: at most one page per owner; slug follows the owner's username.
model Page {
  id String @id @default(uuid())
  userId String @unique
  slug String @unique
  title String?
  description String?
  isPublished Boolean @default(false)
  publishedAt DateTime?
  themeKey String @default("minimal")
  theme Theme @relation(fields: [themeKey], references: [slug], onDelete: Restrict)
  appearanceOverrides Json @default("{}")
  socials SocialProfile[]
  revision Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks PageBlock[]
  analytics AnalyticsEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageBlock {
  id String @id @default(uuid())
  pageId String
  type BlockType
  position Int
  isVisible Boolean @default(true)
  content Json
  mediaId String?
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  analytics AnalyticsEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
  @@index([pageId, isVisible, position])
  @@index([mediaId])
}

model Media {
  id String @id @default(uuid())
  userId String
  storageKey String @unique
  url String
  mimeType String
  size BigInt
  width Int
  height Int
  user User @relation("OwnedMedia", fields: [userId], references: [id], onDelete: Cascade)
  avatarFor User[] @relation("UserAvatar")
  blocks PageBlock[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Add additional block types only with their validated feature implementations.
enum BlockType {
  LINK
  TEXT
  IMAGE
  SOCIAL
  DIVIDER
  YOUTUBE
  SPOTIFY
  EMAIL
  PHONE
  LOCATION
}

model Theme {
  id String @id @default(uuid())
  name String
  slug String @unique
  isSystem Boolean @default(true)
  background Json
  typography Json
  buttons Json
  cards Json
  pages Page[]
  templates PageTemplate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageTemplate {
  key String @id
  name String
  description String
  themeKey String
  theme Theme @relation(fields: [themeKey], references: [slug], onDelete: Restrict)
  blocks Json
}

model SocialProfile {
  id String @id @default(uuid())
  pageId String
  platform SocialPlatform
  username String?
  url String
  position Int
  isVisible Boolean @default(true)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  analytics AnalyticsEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([pageId, position])
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
  X
  LINKEDIN
  FACEBOOK
  TIKTOK
  GITHUB
  DISCORD
  TWITCH
  SPOTIFY
}

model AnalyticsEvent {
  id String @id @default(uuid())
  pageId String
  blockId String?
  socialProfileId String?
  eventType AnalyticsEventType
  ipHash String?
  country String?
  city String?
  device String?
  browser String?
  os String?
  referrer String?
  createdAt DateTime @default(now())
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  block PageBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  socialProfile SocialProfile? @relation(fields: [socialProfileId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@index([pageId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@index([socialProfileId])
}

enum AnalyticsEventType {
  PAGE_VIEW
  LINK_CLICK
  SOCIAL_CLICK
}
